{
  "name": "piko",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "PIKO_DB", "database_name": "piko-db", "database_id": "f6c33e6d-f7df-4257-af0d-2a450d4129dd" }
  ]
}
